    "@ad-alt/platform-core": "workspace:*",
    "@ad-alt/shared": "workspace:*",
    "@ad-alt/telemetry": "workspace:*",
    "@hono/node-server": "^2.0.11",
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.12.31",
    "ioredis": "^5.4.0",
    "pino": "^10.3.1",
    "stripe": "^22.3.2",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
