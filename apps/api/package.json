    "@ad-alt/platform-core": "workspace:*",
    "@ad-alt/shared": "workspace:*",
    "@ad-alt/telemetry": "workspace:*",
    "@hono/node-server": "^1.12.0",
    "@hono/zod-validator": "^0.4.0",
    "hono": "^4.5.0",
    "ioredis": "^5.4.0",
    "pino": "^9.3.0",
    "stripe": "^16.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.15.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
