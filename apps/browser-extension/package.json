{
  "name": "@ad-alt/browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "PromptProfit browser extension — privacy-first sponsored moments in browser-based AI tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/XXBlackMartinXX/Ad-Alt.git",
    "directory": "apps/browser-extension"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "build:test": "node scripts/bundle-test.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build:test && playwright test",
    "test:e2e:headed": "pnpm build:test && playwright test --headed",
    "test:e2e:live": "pnpm build:test && playwright test --config playwright.config.live.ts",
    "test:e2e:selftest": "pnpm build:test && playwright test e2e/dryrun-selftest.smoke.spec.ts --reporter=line",
    "smoke:chatgpt-fixture": "pnpm build:test && playwright test --grep chatgpt-adapter",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@ad-alt/platform-core": "workspace:*",
    "@ad-alt/shared": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
