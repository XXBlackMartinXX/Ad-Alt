{
  "manifest_version": 3,
  "name": "PromptProfit",
  "version": "0.1.0",
  "description": "Earn from your AI tool wait-states. Privacy-first, opt-in sponsored moments.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://www.chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["dist/content/chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["dist/content/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["dist/content/gemini.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PromptProfit"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
