{
  "name": "promptprofit",
  "displayName": "PromptProfit",
  "description": "Earn from your AI coding wait-states. Privacy-first, opt-in sponsored moments.",
  "version": "0.1.0",
  "publisher": "promptprofit",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/XXBlackMartinXX/Ad-Alt.git",
    "directory": "apps/extension"
  },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "promptprofit.enable",
        "title": "PromptProfit: Enable sponsored moments"
      },
      {
        "command": "promptprofit.disable",
        "title": "PromptProfit: Disable sponsored moments"
      },
      {
        "command": "promptprofit.signIn",
        "title": "PromptProfit: Sign in"
      },
      {
        "command": "promptprofit.signOut",
        "title": "PromptProfit: Sign out"
      },
      {
        "command": "promptprofit.showEarnings",
        "title": "PromptProfit: View earnings"
      }
    ],
    "configuration": {
      "title": "PromptProfit",
      "properties": {
        "promptprofit.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable PromptProfit sponsored moments during AI wait-states (requires explicit opt-in)"
        },
        "promptprofit.displaySurface": {
          "type": "string",
          "enum": ["status_bar"],
          "default": "status_bar",
          "description": "Where to display sponsored moments"
        },
        "promptprofit.adapter": {
          "type": "string",
          "enum": ["ai_status_bar", "mock"],
          "default": "ai_status_bar",
          "description": "Wait-state detection method"
        },
        "promptprofit.apiUrl": {
          "type": "string",
          "default": "https://api.promptprofit.dev",
          "description": "PromptProfit API URL (for development use)"
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "build": "npm run compile -- --minify",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "package": "vsce package --no-dependencies",
    "clean": "rm -rf dist *.vsix"
  },
  "dependencies": {
    "@ad-alt/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.31.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
