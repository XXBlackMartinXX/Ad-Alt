{
  "name": "ad-alt",
  "version": "0.0.1",
  "private": true,
  "description": "PromptProfit — Developer wait-state monetization platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @ad-alt/api dev",
    "dev:web": "pnpm --filter @ad-alt/web dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit",
    "clean": "turbo clean && find . -name 'node_modules' -type d -maxdepth 3 -exec rm -rf {} + 2>/dev/null; true",
    "db:generate": "turbo db:generate",
    "db:migrate": "pnpm --filter @ad-alt/database db:migrate",
    "db:seed": "pnpm --filter @ad-alt/database db:seed",
    "db:reset": "pnpm --filter @ad-alt/database db:migrate && pnpm --filter @ad-alt/database db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "extension:package": "pnpm --filter promptprofit package",
    "smoke:chatgpt:live": "pnpm --filter @ad-alt/browser-extension test:e2e:live",
    "smoke:chatgpt:live:stability": "node scripts/run-ps1.js scripts/run-live-chatgpt-stability.ps1",
    "smoke:chatgpt:fixture": "pnpm --filter @ad-alt/browser-extension test:e2e",
    "smoke:chatgpt:report": "node scripts/run-ps1.js scripts/open-latest-live-chatgpt-report.ps1 -PrintOnly",
    "smoke:chatgpt:report:open": "node scripts/run-ps1.js scripts/open-latest-live-chatgpt-report.ps1",
    "smoke:chatgpt:local-api": "node scripts/run-ps1.js scripts/run-local-real-api-smoke.ps1",
    "smoke:chatgpt:local-api:help": "node scripts/run-ps1.js scripts/run-local-real-api-smoke.ps1 -Help",
    "smoke:chatgpt:local-api:report": "node scripts/list-local-api-smoke-reports.js",
    "smoke:chatgpt:reports:list": "node scripts/list-smoke-reports.js",
    "smoke:chatgpt:reports:clean": "node scripts/clean-smoke-reports.js",
    "local:dev-api-key": "node scripts/run-ps1.js scripts/get-local-dev-api-key.ps1",
    "smoke:billing:local": "node scripts/run-ps1.js scripts/run-local-billing-ledger-smoke.ps1",
    "smoke:billing:click:local": "node scripts/run-ps1.js scripts/run-local-click-billing-smoke.ps1",
    "query:local-events": "node scripts/run-ps1.js scripts/query-local-browser-events.ps1",
    "query:local-ledger": "node scripts/run-ps1.js scripts/query-local-ledger.ps1",
    "query:local-billing-events": "node scripts/run-ps1.js scripts/query-local-billing-events.ps1",
    "package:browser:beta": "node scripts/package-browser-extension.mjs",
    "package:browser:public": "node scripts/package-browser-extension.mjs --mode public-release",
    "package:browser:audit": "node scripts/audit-browser-extension-package.js",
    "package:browser:zip:audit": "node scripts/audit-browser-extension-zip.js",
    "package:vscode:audit": "node scripts/audit-vsix-package.js",
    "package:vscode:vsix:audit": "node scripts/audit-vsix-artifact.js",
    "check:ps1": "node scripts/check-ps1-ascii.js",
    "check:secrets:local": "node scripts/check-no-secret-leaks.js",
    "check:report-ascii": "node scripts/check-report-templates-ascii.js",
    "check:license": "node scripts/check-license-decision.js",
    "check:billing:reconciliation": "node scripts/check-billing-reconciliation-readiness.js",
    "icons:create": "node scripts/create-placeholder-icons.mjs",
    "check:internal-beta-packet": "node scripts/check-internal-beta-packet.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.4.0"
}
