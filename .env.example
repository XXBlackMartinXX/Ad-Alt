# ============================================================
# PromptProfit Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Database ----
DATABASE_URL="postgresql://promptprofit:promptprofit_dev@localhost:5432/promptprofit_dev"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Authentication (NextAuth / Auth.js) ----
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ---- OAuth Providers (optional - configure at least one) ----
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Email (Magic Link / local dev SMTP) ----
EMAIL_SERVER_HOST="smtp.maildev.local"
EMAIL_SERVER_PORT="1025"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@promptprofit.dev"

# ---- API ----
API_URL="http://localhost:3001"
API_SECRET_KEY="generate-with: openssl rand -base64 32"
# Used to sign event envelopes from the extension
EVENT_SIGNING_SECRET="generate-with: openssl rand -hex 32"

# ---- Stripe ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---- Feature Flags ----
# Comma-separated list of disabled adapter names (extension kill switch)
DISABLED_ADAPTERS=""
# Master kill switch: set to "true" to disable all ad serving
KILL_SWITCH_ENABLED="false"

# ---- Fraud ----
# Minimum seconds between clicks from the same device
FRAUD_CLICK_MIN_INTERVAL_SECONDS="30"
# Maximum impressions per device per hour
FRAUD_IMPRESSIONS_PER_HOUR_MAX="60"
# Score threshold above which events are held for manual review
FRAUD_REVIEW_THRESHOLD="60"
# Score threshold above which events are auto-blocked
FRAUD_BLOCK_THRESHOLD="85"

# ---- Ledger ----
# Platform fee percentage taken from advertiser spend (integer 0-100)
PLATFORM_FEE_PERCENT="40"
# Developer revenue share percentage (integer 0-100, must sum to 100 with platform fee)
DEVELOPER_SHARE_PERCENT="60"

# ---- Admin ----
# Comma-separated list of email addresses with admin access
ADMIN_EMAILS="admin@promptprofit.dev"

# ---- Observability ----
LOG_LEVEL="info"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="promptprofit-api"

# ---- Extension (baked into extension build; public values only) ----
VSCODE_EXTENSION_API_BASE="http://localhost:3001"
VSCODE_EXTENSION_ANALYTICS_ENDPOINT="http://localhost:3001/v1/events"
