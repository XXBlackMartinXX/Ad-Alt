{
  "name": "@ad-alt/platform-core",
  "version": "0.0.1",
  "description": "Platform-agnostic adapter types, privacy constants, and event contracts for PromptProfit",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
