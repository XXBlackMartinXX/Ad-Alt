{
  "name": "@ad-alt/native-hook-adapter",
  "version": "0.0.1",
  "private": true,
  "description": "Shared no-content normalizer for native Claude Code / Codex hook integrations -- never reads prompt, response, command, or file content",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
